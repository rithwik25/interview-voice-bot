# Required. Never commit a real key.
OPENAI_API_KEY=

# Required for public production deployments so strangers cannot mint OpenAI tokens.
APP_BASIC_AUTH_USERNAME=
APP_BASIC_AUTH_PASSWORD=

# Required for production persistence. If omitted locally, the app uses .data/.
DATABASE_URL=

# Optional model configuration.
REALTIME_MODEL=gpt-realtime
REALTIME_VOICE=marin
REALTIME_TRANSCRIBE_MODEL=gpt-4o-transcribe
ANALYSIS_MODEL=gpt-4o
